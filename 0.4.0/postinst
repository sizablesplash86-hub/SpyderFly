#!/bin/sh
set -e

MAIN_DIR="/etc/spyderfly"
SITES_DIR="/etc/spyderfly/enabled-sites"
INDEX_DIR="/etc/spyderfly/index"
CONF_DIR="/etc/spyderfly/config"
DIS_SITE="/etc/spyderfly/disabled-sites"
LOG_DIR="/etc/spyderfly/log"
MAIN_CONF="/etc/spyderfly/spyderfly.conf"
OUTPUT="/usr/sbin/spyderfly"
SRVCE="/etc/systemd/system/spyderfly.service"
BINRY="https://repo.sizablesplash.com/spyderfly/releases/v1.0.0/binary"

# put the directory names here

# leaving this here to be added to the pkg later
echo "Welcome to the SpyderFly install!"

if ! ls $MAIN_DIR &> /dev/null; then
while true; do
    read -p "Would you like to install Certbot SpyderFly? (y/n): " yn
    case $yn in
        [Yy]* ) 
            echo "Not setup yet"
            # Add your positive action code here
            break
            ;;
        [Nn]* ) 
            echo "If you ever change your mind, run sudo spyderfly --certbot to do the install"
            # Add your negative action or exit code here
            break
            ;;
        * ) 
            echo "Please answer yes (y) or no (n)."
            ;;
    esac
done
fi

echo "[*] Creating directories..."

mkdir -p "$MAIN_DIR" "$INDEX_DIR" "$SITES_DIR" "$CONF_DIR" "$DIS_SITE" "$LOG_DIR"

if ! ls $OUTPUT &> /dev/null; then
    echo "[*] Binary detected! removing..."
    rm -rf "$OUTPUT"
else
    echo "[*] Installing binary..."
fi

curl -sSL "$BINRY" -o "$OUTPUT"
chmod +x "$OUTPUT"

if ! ls $MAIN_DIR &> /dev/null; then
    echo "[*] Creating main config..."
    mkdir -p "$(dirname "$MAIN_CONF")"
    cat << 'EOF' > "$MAIN_CONF"
# this is the main config for SpyderFly
# anything you change will be wiped in an update

listen 80;
root /etc/spyderfly/index/;

include /etc/spyderfly/enabled-sites/*.conf;

minecraft yes;
EOF
fi

# this is the NGINX one, leaving here for notes purpose

