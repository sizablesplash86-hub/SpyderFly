#After=network-online.target remote-fs.target nss-lookup.target
#Wants=network-online.target
#ConditionFileIsExecutable=/usr/sbin/nginx

#[Service]
#Type=forking
#PIDFile=/run/nginx.pid
#ExecStartPre=/usr/sbin/nginx -t -q -g 'daemon on; master_process on;'
#ExecStart=/usr/sbin/nginx -g 'daemon on; master_process on;'
#ExecReload=/usr/sbin/nginx -g 'daemon on; master_process on;' -s reload
#ExecStop=-/sbin/start-stop-daemon --quiet --stop --retry QUIT/5 --pidfile /run/nginx.pid
#TimeoutStopSec=5
#KillMode=mixed

#[Install]
#WantedBy=multi-user.target

echo "[*] Creating daemon service..."

mkdir -p "$(dirname "$SRVCE")"
cat << 'EOF' > "$SRVCE"
[Unit]
Description=SpyderFly Web Server
After=network.target

[Service]
Type=simple
User=root
ExecStart=/usr/sbin/spyderfly  # add something here for this like NGINX's
Restart=always

[Install]
WantedBy=multi-user.target
EOF

echo "SpyderFly installed! Thank you for choosing SpyderFly"