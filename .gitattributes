# Explicitly force recognition of your C codebase
src/**/*.c linguist-language=C
src/**/*.h linguist-language=C

# Tell GitHub to ignore helper scripts and packages in the language bar
scripts/** linguist-detectable=false
spyderfly-pkg/** linguist-detectable=false
"certbot spyderfly/**" linguist-detectable=false
*.sh linguist-detectable=false
