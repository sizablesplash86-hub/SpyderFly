[Unit]
Description=SpyderFly Web Server
Documentation=man:spyderfly(8)
After=network-online.target remote-fs.target nss-lookup.target
Wants=network-online.target
ConditionFileIsExecutable=/usr/bin/spyderfly

[Service]
Type=forking
PIDFile=/run/spyderfly.pid
ExecStartPre=/usr/sbin/spyderfly -t
ExecStart=/usr/sbin/spyderfly -s
ExecReload=/usr/sbin/spyderfly -r
ExecStop=-/sbin/start-stop-daemon --quiet --stop --retry QUIT/5 --pidfile /run/spyderfly.pid
TimeoutStopSec=5
KillMode=mixed
StandardOutput=journal
StandardError=journal
SyslogIdentifier=spyderfly

[Install]
WantedBy=multi-user.target