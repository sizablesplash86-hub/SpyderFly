    "version": "0.2.0",
    "configurations": [
        {
            "name": "C/C++ Debug: Launch with GDB",
            "type": "cppdbg",
            "request": "launch",
            "program": "0.5.0/a.out",
            "args": [],
            "stopAtEntry": true,
            "cwd": "0.5.0/src",
            "environment": [],
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }


    ]
}